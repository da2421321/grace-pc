# Components Organization & Patterns

## UI Component Library

This project uses **@dcloudio/uni-ui** (official component library).

### Available Components
- **Layout**: uni-section, uni-card, uni-collapse, uni-grid
- **Forms**: uni-forms, uni-forms-item, uni-easyinput, uni-data-checkbox
- **Display**: uni-badge, uni-tag, uni-notice-bar, uni-icons
- **Feedback**: uni-load-more, uni-transition
- **Lists**: uni-list, uni-list-item
- **Navigation**: uni-nav-bar, uni-segmented-control, uni-pagination

### Auto-Import
All uni-ui components are auto-imported via easycom - no need to import them!

```vue
<template>
  <view>
    <uni-icons type="heart" size="30" />
    <uni-badge text="10" type="error" />
    <uni-card title="Card Title" />
  </view>
</template>

<script setup lang="ts">
// No need to import uni-* components!
</script>
```

## Component Organization

- **`/src/components/`** - Shared components used across multiple pages
- **Page directory** - Page-specific components stay with the page
- **Extract when**: Component exceeds ~200 lines or is reused

## Common Patterns

### List View with Pagination
```vue
<script setup lang="ts">
import { ref } from 'vue'
import { onLoad, onPullDownRefresh, onReachBottom } from '@dcloudio/uni-app'
import apis from '@/api'

const list = ref([])
const loading = ref(false)
const finished = ref(false)
const page = ref(1)

async function loadData() {
  if (loading.value || finished.value) return
  
  loading.value = true
  try {
    const res = await apis.getList({ pageNum: page.value++, pageSize: 10 })
    list.value.push(...res.rows)
    if (res.rows.length < 10) finished.value = true
  } catch (error) {
    uni.showToast({ title: '加载失败', icon: 'none' })
  } finally {
    loading.value = false
  }
}

async function refreshData() {
  page.value = 1
  finished.value = false
  list.value = []
  await loadData()
  uni.stopPullDownRefresh()
}

onLoad(() => loadData())
onPullDownRefresh(() => refreshData())
onReachBottom(() => loadData())
</script>

<template>
  <view class="page">
    <view v-for="item in list" :key="item.id" class="item">
      <text>{{ item.name }}</text>
    </view>
    <uni-load-more v-if="loading" status="loading" />
    <uni-load-more v-else-if="finished" status="noMore" />
  </view>
</template>
```

### Form Component
```vue
<script setup lang="ts">
import { reactive, ref } from 'vue'
import apis from '@/api'

const form = reactive({
  username: '',
  email: '',
  phone: ''
})

const formRef = ref(null)

async function handleSubmit() {
  if (!form.username) {
    uni.showToast({ title: '请输入用户名', icon: 'none' })
    return
  }
  
  try {
    uni.showLoading({ title: '提交中...' })
    await apis.user.update(form)
    uni.showToast({ title: '保存成功', icon: 'success' })
    setTimeout(() => uni.navigateBack(), 1500)
  } finally {
    uni.hideLoading()
  }
}
</script>

<template>
  <view class="page p-4">
    <uni-forms ref="formRef" :model="form">
      <uni-forms-item label="用户名" required>
        <uni-easyinput v-model="form.username" placeholder="请输入用户名" />
      </uni-forms-item>
      <uni-forms-item label="邮箱" required>
        <uni-easyinput v-model="form.email" type="email" placeholder="请输入邮箱" />
      </uni-forms-item>
    </uni-forms>
    <button class="mt-8 bg-blue-500 text-white rounded-full" @click="handleSubmit">
      提交
    </button>
  </view>
</template>
```

### Modal/Confirm Dialog
```vue
<script setup lang="ts">
import { showModalAsync } from '@/utils/promisify'

async function showConfirm() {
  try {
    await showModalAsync({
      title: '提示',
      content: '确认执行此操作吗？'
    })
    // User confirmed
    await handleAction()
  } catch (error) {
    // User canceled, showModalAsync throws on cancel
  }
}

async function handleAction() {
  // Process action
}
</script>
```

### Image Upload
```vue
<script setup lang="ts">
import { ref } from 'vue'
import { useUserStore } from '@/store/user'
import { chooseMedia, uploadFile, showToastAsync } from '@/utils/promisify'

const userStore = useUserStore()
const imageUrl = ref('')

async function handleUpload() {
  try {
    // Use promisified API
    const res = await chooseMedia({
      count: 1,
      mediaType: ['image'],
      sizeType: ['compressed'],
      sourceType: ['album', 'camera']
    })
    
    uni.showLoading({ title: '上传中...' })
    
    const uploadRes = await uploadFile({
      url: `${import.meta.env.VITE_APP_BASE_URL}/common/upload`,
      filePath: res.tempFiles[0].tempFilePath,
      name: 'file',
      header: { 'Authorization': `Bearer ${userStore.token}` }
    })
    
    const data = JSON.parse(uploadRes.data)
    imageUrl.value = data.url
    await showToastAsync({ title: '上传成功', icon: 'success' })
  } catch (error) {
    await showToastAsync({ title: '上传失败', icon: 'none' })
  } finally {
    uni.hideLoading()
  }
}
</script>

<template>
  <view class="upload-box w-[200rpx] h-[200rpx]" @click="handleUpload">
    <image v-if="imageUrl" :src="imageUrl" class="w-full h-full" />
    <uni-icons v-else type="camera" size="50" color="#999" />
  </view>
</template>
```

